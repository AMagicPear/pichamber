{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["src/**/*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "strictNullChecks": false,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  }
}
