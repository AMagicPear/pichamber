{
  "name": "@amagicpear/pichamber",
  "version": "0.9.3",
  "description": "A browser-based workspace for the Pi Coding Agent",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "AMagicPear",
    "url": "https://github.com/AMagicPear"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "ai",
    "assistant",
    "ide",
    "workspace",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AMagicPear/pichamber.git"
  },
  "homepage": "https://github.com/AMagicPear/pichamber#readme",
  "bugs": {
    "url": "https://github.com/AMagicPear/pichamber/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "catalog": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@tsconfig/node24": "^24.0.5",
    "bun-pty": "^0.4.10",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "dev": "bun run --filter @amagicpear/pichamber-server --filter @amagicpear/pichamber-web dev",
    "build": "bun --filter '*' build",
    "build:web": "bun --filter @amagicpear/pichamber-web build",
    "build:server": "bun --filter @amagicpear/pichamber-server build",
    "test": "bun test",
    "type-check": "bun --filter '*' type-check",
    "lint": "oxlint . --fix",
    "prepack": "bun run build:web && rm -rf dist dist-web && mkdir -p dist && bun build packages/server/src/index.ts --outfile dist/server.js --target bun --external bun-pty --external @earendil-works/pi-coding-agent && cp -r packages/web/dist dist-web"
  },
  "bin": {
    "pichamber": "bin/pichamber.js"
  },
  "files": [
    "dist",
    "dist-web",
    "bin/pichamber.js",
    "bin/cli.js",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "bun-pty": "catalog:",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "bun-types": "^1.4.0",
    "oxlint": "~1.79.0",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc"
  }
}