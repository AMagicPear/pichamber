{
  "name": "@amagicpear/pichamber",
  "version": "1.0.2",
  "description": "A browser-based workspace for the Pi Coding Agent",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "AMagicPear",
    "url": "https://github.com/AMagicPear"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "ai",
    "assistant",
    "ide",
    "workspace",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AMagicPear/pichamber.git"
  },
  "homepage": "https://github.com/AMagicPear/pichamber#readme",
  "bugs": {
    "url": "https://github.com/AMagicPear/pichamber/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "catalog": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@tsconfig/node24": "^24.0.5",
    "bun-pty": "^0.4.10",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "dev": "bun run --filter @amagicpear/pichamber-server --filter @amagicpear/pichamber-web dev",
    "dev:web": "bun --filter @amagicpear/pichamber-web dev",
    "dev:server": "bun --filter @amagicpear/pichamber-server dev",
    "build": "bun --filter '*' build",
    "build:web": "bun --filter @amagicpear/pichamber-web build",
    "build:server": "bun --filter @amagicpear/pichamber-server build",
    "test": "bun test",
    "type-check": "bun --filter '*' type-check",
    "lint": "oxlint . --fix",
    "preview": "bun run build && bun packages/cli/src/index.ts",
    "prepack": "bun run build"
  },
  "bin": {
    "pichamber": "packages/cli/src/index.ts"
  },
  "files": [
    "packages/cli/src",
    "packages/server/dist",
    "packages/web/dist",
    "packages/builtin-extensions",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "bun-pty": "^0.4.10",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "bun-types": "^1.4.0",
    "oxlint": "~1.80.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
