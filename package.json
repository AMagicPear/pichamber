{
  "name": "@amagicpear/pichamber",
  "version": "0.7.0",
  "description": "A browser-based workspace for the Pi Coding Agent",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "AMagicPear",
    "url": "https://github.com/AMagicPear"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "ai",
    "assistant",
    "ide",
    "workspace",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AMagicPear/pichamber.git"
  },
  "homepage": "https://github.com/AMagicPear/pichamber#readme",
  "bugs": {
    "url": "https://github.com/AMagicPear/pichamber/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "catalog": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2"
  },
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,WEB\" -c \"cyan,magenta\" \"bun run dev:server\" \"bun run dev:web\"",
    "dev:web": "bun --filter @amagicpear/pichamber-web dev",
    "dev:server": "bun --filter @amagicpear/pichamber-server dev",
    "build": "bun --filter '*' build",
    "build:web": "bun --filter @amagicpear/pichamber-web build",
    "build:server": "bun --filter @amagicpear/pichamber-server build",
    "test": "bun test",
    "type-check": "bun --filter '*' type-check",
    "lint": "oxlint . --fix",
    "package": "node scripts/package.mjs",
    "prepack": "bun run package"
  },
  "bin": {
    "pichamber": "bin/pichamber.js"
  },
  "files": [
    "dist",
    "dist-web",
    "bin/pichamber.js",
    "bin/cli.js",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "bun-pty": "^0.4.10",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "bun-types": "^1.4.0",
    "concurrently": "^10.0.5",
    "oxlint": "~1.78.0",
    "typescript": "~7.0.2",
    "typescript6": "npm:@typescript/typescript6@^6.0.2",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc"
  }
}
